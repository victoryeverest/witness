# WITNESS environment configuration template.
# Copy this file to `.env` (or backend/.env) and edit values as needed.
# All variables are prefixed WITNESS_ and are read by pydantic-settings.

# --- Runtime ---
WITNESS_ENVIRONMENT=development
WITNESS_LOG_LEVEL=INFO
WITNESS_HOST=0.0.0.0
WITNESS_PORT=8000

# --- Database ---
# Default: SQLite (local-first, no external services). Works on Linux/macOS/Windows.
# Production: swap to PostgreSQL by changing this URL.
WITNESS_DATABASE_URL=sqlite+aiosqlite:///data/witness.db
WITNESS_DB_ECHO=false

# --- Privacy / Data residency ---
# LOCAL_ONLY = no outbound calls. ALLOW_EXTERNAL = permit real LLM providers.
WITNESS_PRIVACY_MODE=LOCAL_ONLY

# --- Model layer ---
# mock = deterministic, no LLM (default; required for tests/benchmarks)
# openai_compatible = any OpenAI /v1/chat/completions endpoint (vLLM, llama.cpp, Ollama, OpenAI)
# ollama = native Ollama API
WITNESS_MODEL_PROVIDER=mock
WITNESS_MODEL_SMALL=mock-small
WITNESS_MODEL_MEDIUM=mock-medium
WITNESS_MODEL_STRONG=mock-strong
WITNESS_MODEL_ENDPOINT=
WITNESS_MODEL_API_KEY=
WITNESS_MODEL_TIMEOUT_SECONDS=30
WITNESS_MODEL_MAX_RETRIES=2
# Example: uncensored Qwen3-8B on a GPU box on the private network (see docs/MODEL_CARD.md)
#   WITNESS_MODEL_PROVIDER=openai_compatible
#   WITNESS_MODEL_ENDPOINT=http://10.0.0.42:8000/v1
#   WITNESS_MODEL_MEDIUM=qwen3-8b
#   WITNESS_MODEL_STRONG=qwen3-8b
#   WITNESS_MODEL_TIMEOUT_SECONDS=120
# Then verify: cd backend && python -m witness.models_layer.check
# auto = model assistance on whenever a real provider is configured.
WITNESS_MODEL_ASSIST=auto
WITNESS_MODEL_ASSIST_MAX_HYPOTHESES=3
# Qwen3: append /no_think and strip <think> blocks.
WITNESS_MODEL_DISABLE_THINKING=true

# --- Authentication (§68) ---
# none  = development only; identity is whatever the caller claims.
# token = every request needs `Authorization: Bearer <token>`; identity and
#         role come from WITNESS_API_TOKENS. Production refuses to start with
#         `none` unless WITNESS_ALLOW_INSECURE_PRODUCTION=true.
WITNESS_AUTH_MODE=none
# Comma-separated token:user_id:role. Use long random tokens, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: viewer analyst senior_analyst responder ot_analyst ot_engineer
#        security_engineer approver auditor admin
# WITNESS_API_TOKENS=<token1>:alice:security_engineer,<token2>:bob:ot_engineer,<token3>:carol:approver
WITNESS_API_TOKENS=
WITNESS_ALLOW_INSECURE_PRODUCTION=false

# --- PCAP ingestion (§33) ---
# /pcap/analyze only reads inside this directory; /pcap/upload writes here.
WITNESS_PCAP_DIR=data/pcaps
WITNESS_PCAP_MAX_UPLOAD_BYTES=209715200

# --- Maintenance ---
# POST /system/reset drops all tables. Always disabled in production.
WITNESS_ALLOW_RESET=true

# --- Frontend ---
# Where `next dev` / `next start` forward /api/witness/* (server-side only).
WITNESS_BACKEND_URL=http://localhost:8000

# --- Safety defaults (do NOT disable in production) ---
WITNESS_REQUIRE_APPROVAL_HIGH_RISK=true
WITNESS_OT_REQUIRES_DUAL_APPROVAL=true

# --- Investigation runtime ---
WITNESS_INVESTIGATION_MAX_ITERATIONS=25
WITNESS_INVESTIGATION_CONFIDENCE_THRESHOLD=0.75
WITNESS_INVESTIGATION_STEP_TIMEOUT_SECONDS=60

# --- Benchmark ---
WITNESS_BENCHMARK_DEFAULT_ITERATIONS=1

# --- Knowledge layer (§99-101) ---
# Where to cache downloaded MITRE ATT&CK STIX bundles.
WITNESS_KNOWLEDGE_DIR=data/knowledge
# Whether to auto-load MITRE ATT&CK knowledge on startup.
WITNESS_AUTOLOAD_ATTACK=true
